# CRATES N' PLATES — environment template.
# Copy to `.env` at the project root and fill in real values:
#   cp .env.example .env
# Values here are placeholders — never commit the real .env.

# Realtime Database URL — copy VERBATIM from Firebase Console → Realtime
# Database (shown above your data tree). Regional databases use
# *.firebasedatabase.app; the .firebaseio.com shape only works for us-central.
FIREBASE_URL="https://your-db-default-rtdb.asia-southeast1.firebasedatabase.app"

# Gmail account that sends OTP / order / receipt emails.
SMTP_USER="your@gmail.com"
# 16-character App Password (Google Account → Security → 2-Step Verification
# → App passwords). NOT the account login password.

SMTP_PASS="16-char-app-password"
MAIL_FROM="your@gmail.com"

# Optional OAuth client ID enabling Google sign-in on the customer login page.
GOOGLE_CLIENT_ID=""

# Dev-only: "1" shows OTPs on screen when SMTP is down. Never in production.
DEV_MODE="0"

# Production only (Render env var, not needed locally): full service-account
# JSON key, single line when placed in this file — the loader parses
# line-by-line. Signs every database request once rules require auth != null.
# FIREBASE_CREDENTIALS={"type":"service_account",...}
