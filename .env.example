APP_NAME="Crates N' Plates"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# Sign in with Google (Laravel Socialite). One button, no passwords anywhere.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI="${APP_URL}/auth/google/callback"

# First admin (one-shot `php artisan staff:seed --admin`). No credentials in
# the repo; the seeder refuses to run once any staff row exists.
STAFF_ADMIN_NAME=
STAFF_ADMIN_EMAIL=
# Short cache window for a staff role read; any staff write evicts it at once.
STAFF_ROLE_CACHE_TTL=60

# Trusted proxy ranges for the real client IP behind nginx/Cloudflare, so the
# checkout and login rate limits count per customer, not per proxy socket.
# Comma-separated ranges, or `*` to trust the calling address.
TRUSTED_PROXIES=

# Firebase Realtime Database is the sole datastore. No SQL, no Eloquent.
FIREBASE_DATABASE_URL=https://crnp.firebaseio.com
# Defaults to storage/app/firebase-service-account.json when unset.
# FIREBASE_SERVICE_ACCOUNT_PATH=
# Inline service-account JSON for hosts without a writable file (e.g. Render);
# wins over the path when set.
# FIREBASE_SERVICE_ACCOUNT_JSON=
FIREBASE_TOKEN_URI=https://oauth2.googleapis.com/token
FIREBASE_TOKEN_TTL=3300

# Laravel's own session and cache use the file driver — no SQL datastore.
SESSION_DRIVER=file
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=sync

CACHE_STORE=file
# CACHE_PREFIX=

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false
